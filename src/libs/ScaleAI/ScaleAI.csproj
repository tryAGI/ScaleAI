<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CS3002;CS3003;CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>C# SDK for the Scale AI API -- data labeling, RLHF, and AI evaluation.</Description>
    <PackageId>ScaleAI</PackageId>
    <PackageTags>api;client;sdk;dotnet;openapi;scale-ai;data-labeling;rlhf;evaluation;ai;autosdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
  </ItemGroup>

</Project>
